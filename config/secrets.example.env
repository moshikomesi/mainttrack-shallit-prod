# Copy to the server (e.g. /etc/mainttrack/secrets.env) and load from systemd.
# Never commit real secrets to git.

ASPNETCORE_ENVIRONMENT=Production
MAINTTRACK_DB_CONNECTION=Host=localhost;Port=5432;Database=mainttrack;Username=CHANGE_ME;Password=CHANGE_ME
Jwt__Key=CHANGE_ME_MIN_32_CHARS

# Local development (Docker Postgres container mainttrack-postgres):
# MAINTTRACK_DB_CONNECTION=Host=localhost;Port=5432;Database=mainttrack_dev;Username=postgres;Password=postgres
# Stop brew Postgres first: brew services stop postgresql@14
